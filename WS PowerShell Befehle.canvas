{
	"nodes":[
		{"id":"2f117ac55ad2ccf5","type":"text","text":"# DNS & Netzwerk\nipconfig /flushdns\nipconfig /registerdns\nIPCONFIG -?\nGet-DnsClient -InterfaceAlias\nGet-NetAdapter\nSet-DnsClientServerAddress -InterfaceIndex [Nr.] -ServerAddresses [DNS-Server-IP]\ndnsmgmt.msc\n\n# IPv6 & Netzwerkschnittstellen\nnetsh interface ipv6 isatap set state enabled\nSet-NetIPInterface -InterfaceAlias \"Privat2\" -DHCP Enabled\nNew-NetIPAddress -InterfaceAlias Privat2 -IPAddress 192.168.1.220 -PrefixLength 24 -DefaultGateway 192.168.1.1\nSet-DnsClientServerAddress -InterfaceAlias \"Ethernet\" -ServerAddresses \"DNS-IP1, DNS-IP2\"\n\n# Namensauflösung & DNS\nnbtstat -R\nnslookup\n\n# AD – Organisationen & User\nNew-ADOrganizationalUnit -Name \"Sales\" -Path \"OU=Schulung,DC=example,DC=com\"\nNew-ADUser -Name \"thomas klein\" -SamAccountName \"tklein\" -UserPrincipalName \"tklein@example.com\" -PasswordNeverExpires $true -AccountPassword $Password -Enabled $true -Path \"OU=HR,OU=Schulung,DC=example,DC=com\"\nNew-LocalUser -Name \"Benutzername\" -Password (ConvertTo-SecureString \"Passwort\" -AsPlainText -Force)\n\n# AD – Computer & Domäne\nSet-DnsClientServerAdress -InterfaceAlias ethernet -ServerAddresses 192.168.1.200\nAdd-Computer -DomainName example.com -Restart\nredircmp \"OU=HR,OU=Schulung,DC=example,DC=com\"\nredircmp \"CN=Computers,DC=example,DC=com\"\n\n# AD – Gruppen\nNew-ADGroup -Name \"[Gruppenname]\" -Path \"[DN zur Gruppe]\" -GroupScope Global\nAdd-ADGroupMember -Identity [Gruppe] -Members [Principal]\n\n# AD – Service Accounts\nAdd-KdsRootKey -EffectiveTime ((get-date).AddHours(-10))\nNew-ADServiceAccount [Dienstkonto] -PrincipalsAllowedToRetrieveManagedPassword [Zielcomputer]\nInstall-ADServiceAccount [Accountname]\nSet-ADServiceAccount -Identity \"mygmsa1\" -PrincipalsAllowedToRetrieveManagedPassword \"EXA-SRV01$\",\"EXA-SRV02$\"\nGet-ADServiceAccount | fl -Property *\nsetspn -S http:/exa-srv01.example.com:80 example\\mysvc1\n\n# Gruppenrichtlinien (GPO)\ngpupdate /force\nInvoke-GPUpdate -RandomDelayInMinutes 0 -Computer exa-cl01 -Force\ngpedit.msc\ndcgpofix /:Target:Domain\ngpresult\n\n# Remote PowerShell\nwinrm quickconfig\nEnter-PSSession exa-dc01\nSet-Item WSMan:\\localhost\\Client\\TrustedHosts exa-srv02.example.com\nInvoke-Command -ComputerName \"192.168.1.203\" -Credential $cred -ScriptBlock {}\nNew-PSSession -ComputerName [Computer]\nEnter-PSSession -id [ID]\nGet-PSSession\nRemove-PSSession [Nr]\nTest-ComputerSecureChannel -Repair -Credential (Get-Credential)\n\n# Sicherheitsrichtlinien\nsecpol.msc\nregsvr32 schmmgmt.dll\n\n# Sonstiges\nntdsutil\nnet stop ntds\nnet stop netlogon\nnet start netlogon\nmsconfig\ndsamain -dbpath [Pfad]\\NTDS\\ntds.dit -ldapport 5000","x":-1520,"y":-2760,"width":2200,"height":4440}
	],
	"edges":[]
}